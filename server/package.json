    "express-rate-limit": "^7.0.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.1",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.6.2",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.0",
    "validator": "^13.9.0"
